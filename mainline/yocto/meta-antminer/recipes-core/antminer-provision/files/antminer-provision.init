#!/bin/sh
### BEGIN INIT INFO
# Provides:          antminer-provision
# Required-Start:    networking
# Default-Start:     5
# Short-Description: provisioning SD card: mount the boot partition, show where the web UI is
### END INIT INFO
case "$1" in
  start)
    mountpoint -q /boot || mount /boot 2>/dev/null || echo "antminer-provision: /boot (mmcblk0p1) not mounted"
    ip=$(ip -4 -o addr show eth0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
    mac=$(cat /sys/class/net/eth0/address 2>/dev/null)
    sysboot=$(devmem 0x44E10040 2>/dev/null)
    {
      echo "========================================================"
      echo " Antminer provisioning system (running from the SD card)"
      echo "   board MAC $mac   SYSBOOT $sysboot"
      echo "   web UI:  http://${ip:-<waiting for DHCP>}/"
      echo "   ssh:     root@${ip:-?} (no password)"
      echo "========================================================"
    } | tee /dev/console
    ;;
  stop) ;;
  *) echo "Usage: $0 {start|stop}"; exit 1 ;;
esac
exit 0
