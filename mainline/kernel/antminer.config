# Kconfig fragment for the Antminer BB-Black V1.8 on top of omap2plus_defconfig.
# Everything needed for the first boot from SD with the old Angstrom initramfs is
# built in (=y) so no modules are required.
#
# Usage (inside the kernel tree, ARCH=arm):
#   make omap2plus_defconfig
#   scripts/kconfig/merge_config.sh -m .config /path/to/antminer.config
#   make olddefconfig

# --- boot / initramfs ---------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SYSVIPC=y
CONFIG_TMPFS=y

# --- console ------------------------------------------------------------------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_OMAP=y
# lets "console=ttyO0" from the old U-Boot env still select ttyS0
CONFIG_SERIAL_8250_OMAP_TTYO_FIXUP=y
CONFIG_SERIAL_8250_NR_UARTS=8
CONFIG_SERIAL_8250_RUNTIME_UARTS=8

# --- NAND / MTD (GPMC + BCH8 + ELM) ------------------------------------------
CONFIG_OMAP_GPMC=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD_NAND_OMAP2=y
CONFIG_MTD_NAND_OMAP_BCH=y
CONFIG_MTD_NAND_ECC_SW_BCH=y
CONFIG_MTD_UBI=y
CONFIG_JFFS2_FS=y
CONFIG_JFFS2_SUMMARY=y
CONFIG_UBIFS_FS=y

# --- Ethernet (CPSW switchdev, used by am335x-bone-common mac_sw) -------------
CONFIG_TI_CPSW=y
CONFIG_TI_CPSW_SWITCHDEV=y
CONFIG_TI_DAVINCI_MDIO=y
CONFIG_TI_CPSW_PHY_SEL=y
CONFIG_SMSC_PHY=y
CONFIG_NET_SWITCHDEV=y

# --- SD card ------------------------------------------------------------------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OMAP=y
CONFIG_VFAT_FS=y
CONFIG_EXT4_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# --- PMIC / regulators / cpufreq ---------------------------------------------
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_OMAP=y
CONFIG_MFD_TPS65217=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_TPS65217=y
CONFIG_POWER_RESET=y
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_TI_CPUFREQ=y

# --- GPIO / pinctrl / PWM / SPI / ADC (industrial I/O) ------------------------
CONFIG_PINCTRL_SINGLE=y
CONFIG_GPIO_OMAP=y
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_CDEV_V1=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_PWM=y
CONFIG_PWM_TIEHRPWM=y
CONFIG_PWM_TIECAP=y
CONFIG_SPI=y
CONFIG_SPI_OMAP24XX=y
CONFIG_SPI_SPIDEV=y
CONFIG_MFD_TI_AM335X_TSCADC=y
CONFIG_TI_AM335X_ADC=y
CONFIG_IIO=y

# --- RTC / watchdog -----------------------------------------------------------
CONFIG_RTC_DRV_OMAP=y
CONFIG_OMAP_WATCHDOG=y

# --- USB (host for a stick / serial adapters) --------------------------------
CONFIG_USB=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_DSPS=y
CONFIG_USB_STORAGE=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_CH341=y
# USB PHY drivers stay =m in omap2plus (USB_GADGET=m); not needed for the first boots

# --- crypto accelerators (present on the SoC) --------------------------------
CONFIG_CRYPTO_DEV_OMAP=y
CONFIG_CRYPTO_DEV_OMAP_SHAM=y
CONFIG_CRYPTO_DEV_OMAP_AES=y

# --- not on this board --------------------------------------------------------
# CONFIG_DRM is not set
# CONFIG_DRM_TILCDC is not set
# CONFIG_SOUND is not set
# CONFIG_PRU_REMOTEPROC is not set
# CONFIG_TI_PRUSS is not set
