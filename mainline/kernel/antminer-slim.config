# Slimming fragment, applied AFTER antminer.config on top of omap2plus_defconfig.
# Goal: uImage well under the 5 MiB NAND "kernel" partition (0x500000 = 5242880 bytes),
# for an initramfs-only board with Ethernet, UART, GPIO, ADC, PWM, I2C, SPI, NAND.
# No USB port, no display, no audio, no SD-root, no PRU/SGX on AM3352.

# --- compression / code size -------------------------------------------------
CONFIG_KERNEL_XZ=y
# CONFIG_KERNEL_LZO is not set
# CONFIG_KERNEL_GZIP is not set
CONFIG_THUMB2_KERNEL=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set

# --- only AM33xx ------------------------------------------------------------------
# ARMv6 multiplatform support (for OMAP2) keeps CPU_V6K selected, which blocks THUMB2_KERNEL
# CONFIG_ARCH_MULTI_V6 is not set
CONFIG_ARCH_MULTI_V7=y
CONFIG_SOC_AM33XX=y
# CONFIG_ARCH_OMAP3 is not set
# CONFIG_ARCH_OMAP4 is not set
# CONFIG_SOC_OMAP5 is not set
# CONFIG_SOC_AM43XX is not set
# CONFIG_SOC_DRA7XX is not set
# CONFIG_SOC_TI81XX is not set
# CONFIG_ARCH_OMAP2 is not set
# CONFIG_SMP is not set
# CONFIG_HIGHMEM is not set
# CONFIG_ARM_LPAE is not set
# CONFIG_ARM_ERRATA_430973 is not set
# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set

# --- no display / no audio / no input devices -------------------------------------
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set
# CONFIG_LOGO is not set
# CONFIG_VT is not set
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_VIDEO_DEV is not set
# CONFIG_INPUT_EVDEV is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_MISC is not set
# CONFIG_HID is not set
# CONFIG_HID_SUPPORT is not set

# --- no USB connector on the board -------------------------------------------------
# CONFIG_USB_SUPPORT is not set
# CONFIG_USB is not set
# CONFIG_USB_GADGET is not set
# CONFIG_USB_MUSB_HDRC is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_USB_SERIAL is not set
# CONFIG_SCSI is not set
# CONFIG_BLK_DEV_SD is not set
# CONFIG_ATA is not set
# CONFIG_MD is not set
# CONFIG_PCI is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_STAGING is not set
# CONFIG_UIO is not set

# --- no wireless / bluetooth / can for now -----------------------------------------
# CONFIG_WIRELESS is not set
# CONFIG_CFG80211 is not set
# CONFIG_WLAN is not set
# CONFIG_BT is not set
# CONFIG_RFKILL is not set
# CONFIG_CAN is not set
# CONFIG_NFC is not set

# --- network: IPv4 only, no netfilter, no network filesystems ---------------------
# CONFIG_IPV6 is not set
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_NET_SCHED is not set
# CONFIG_IP_PNP is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_NFS_FS is not set
# CONFIG_ROOT_NFS is not set
# CONFIG_CIFS is not set
# CONFIG_9P_FS is not set
# CONFIG_NET_9P is not set
# CONFIG_USB_NET_DRIVERS is not set
# CONFIG_PPP is not set
# CONFIG_SLIP is not set
# CONFIG_TI_DAVINCI_EMAC is not set
# CONFIG_TI_CPSW is not set
CONFIG_TI_CPSW_SWITCHDEV=y
# CONFIG_NET_VENDOR_INTEL is not set
# CONFIG_NET_VENDOR_REALTEK is not set
# CONFIG_NET_VENDOR_MICROCHIP is not set
# CONFIG_NET_VENDOR_SMSC is not set

# --- filesystems: ramfs + jffs2 (config) + ubifs (data), no block fs ---------------
# CONFIG_EXT2_FS is not set
# CONFIG_EXT3_FS is not set
# CONFIG_EXT4_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_MSDOS_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_EXFAT_FS is not set
# CONFIG_NTFS3_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_FUSE_FS is not set
# CONFIG_AUTOFS_FS is not set
# CONFIG_QUOTA is not set
# CONFIG_SQUASHFS is not set
# CONFIG_CRAMFS is not set
# CONFIG_ROMFS_FS is not set
CONFIG_OVERLAY_FS=y
CONFIG_JFFS2_FS=y
CONFIG_JFFS2_SUMMARY=y
CONFIG_MTD_UBI=y
CONFIG_UBIFS_FS=y
CONFIG_UBIFS_FS_LZO=y
CONFIG_UBIFS_FS_ZLIB=y
# CONFIG_UBIFS_FS_ZSTD is not set
# CONFIG_UBIFS_FS_AUTHENTICATION is not set
# CONFIG_MMC is not set
# CONFIG_MMC_OMAP_HS is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_RD_GZIP=y

# --- debugging / tracing / profiling off ------------------------------------------
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_KPROBES is not set
# CONFIG_FTRACE is not set
# CONFIG_PROFILING is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_AUDIT is not set
# CONFIG_SECURITY is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_IKCONFIG is not set
# CONFIG_PM_DEBUG is not set
# CONFIG_PRINTK_TIME is not set
CONFIG_DEBUG_FS=y
CONFIG_PRINTK_TIME=y

# --- crypto: keep only what the hw accelerators and ubifs need --------------------
