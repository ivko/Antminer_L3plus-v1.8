#!/bin/sh
### BEGIN INIT INFO
# Provides:          antminer-config
# Required-Start:    hostname mountall
# Default-Start:     S
# Short-Description: per-board identity and persistent dirs on the NAND /config partition
### END INIT INFO
#
# /config (jffs2, NAND mtd9) is the only writable persistent storage of the module:
#   /config/hostname            optional, overrides the MAC-derived name
#   /config/ssh/                SSH host key (DROPBEAR_RSAKEY_DIR in /etc/default/dropbear)
#   /config/ssh/authorized_keys optional, linked to /root/.ssh/authorized_keys
#   /config/network             optional: MODE=static ADDRESS=.. NETMASK=.. GATEWAY=.. DNS=..
#                               (sh syntax); anything else or missing -> DHCP
#   /config/ntp-server          optional, see antminer-ntp
#   /config/pinmux/*.yaml       board-local pinmux profiles (antminer-dtb / web UI)
# Boards provisioned from the Bitmain firmware may still carry its files here (cgminer.conf,
# dropbear, shadow, ...); they are ignored. flash-nand.sh --wipe-config erases the partition.

write_interfaces() {
    MODE=dhcp; ADDRESS=; NETMASK=255.255.255.0; GATEWAY=; DNS=
    [ -s /config/network ] && . /config/network 2>/dev/null
    {
        echo "# generated by antminer-config from /config/network ($(date -u +%FT%TZ))"
        echo "auto lo"; echo "iface lo inet loopback"; echo
        echo "auto eth0"
        if [ "$MODE" = "static" ] && [ -n "$ADDRESS" ]; then
            echo "iface eth0 inet static"
            echo "    address $ADDRESS"
            echo "    netmask ${NETMASK:-255.255.255.0}"
            [ -n "$GATEWAY" ] && echo "    gateway $GATEWAY"
            [ -n "$DNS" ] && echo "    dns-nameservers $DNS"
            echo "antminer-config: network static $ADDRESS/$NETMASK gw ${GATEWAY:--}" >&2
        else
            echo "iface eth0 inet dhcp"
            echo "    udhcpc_opts -t 0"
        fi
    } > /etc/network/interfaces
    if [ "$MODE" = "static" ] && [ -n "$DNS" ]; then
        for d in $DNS; do echo "nameserver $d"; done > /etc/resolv.conf
    fi
}

case "$1" in
  start)
    if ! grep -qs ' /config ' /proc/mounts; then
        mount /config 2>/dev/null || echo "antminer-config: /config not mounted, settings are volatile"
    fi
    mkdir -p /config/ssh /config/pinmux 2>/dev/null

    MAC=$(cat /sys/class/net/eth0/address 2>/dev/null | tr -d ':')
    if [ -s /config/hostname ]; then
        H=$(head -n 1 /config/hostname | tr -cd 'A-Za-z0-9-')
    fi
    [ -n "$H" ] || H="antminer-${MAC#??????}"      # last 3 MAC bytes, e.g. antminer-731c92
    echo "$H" > /etc/hostname
    hostname "$H"
    grep -q "[[:space:]]$H\$" /etc/hosts 2>/dev/null || echo "127.0.1.1	$H" >> /etc/hosts
    echo "antminer-config: hostname $H (mac $MAC)"

    write_interfaces
    # root's authorized SSH keys live on the config partition
    mkdir -p /root/.ssh && chmod 700 /root/.ssh
    [ -e /root/.ssh/authorized_keys ] || ln -s /config/ssh/authorized_keys /root/.ssh/authorized_keys
    ;;
  stop|status) ;;
  *)
    echo "Usage: $0 {start}"
    exit 1
    ;;
esac
exit 0
